# Dedicated WAM AI DB credentials — NEVER use application service-role keys.
# Copy to a private env file on the VPS (not committed). Values are placeholders only.
#
# WAM_AI_IDENTITY_MODE is REQUIRED. Exact values only: production | development
# Missing/empty/misspelled values fail startup (no silent default).

# --- Local development (localhost DB only; remote/Supabase hosts are rejected) ---
WAM_AI_IDENTITY_MODE=development
WAM_AI_DATABASE_URL=postgresql://wam_ai_business_readonly:[REDACTED]@localhost:5432/postgres
WAM_AI_REQUIRED_DB_USER=wam_ai_business_readonly

WAM_AI_INSTANCE_ID=local-dev
WAM_AI_INSTANCE_ACTOR_ID=unverified_local
WAM_AI_INSTANCE_ACTOR_ROLE=business_partner
# WAM_AI_SESSION_ID=

# --- Production (owner Gateway) — managed by Bonface/root only ---
# WAM_AI_IDENTITY_MODE=production
# WAM_AI_DATABASE_URL=postgresql://wam_ai_business_readonly:[REDACTED]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# WAM_AI_INSTANCE_ID=gw-owner
# WAM_AI_INSTANCE_ACTOR_ID=bonface
# WAM_AI_INSTANCE_ACTOR_ROLE=technical_owner

# --- Production (partner Gateway) — env owned by Bonface/root; partner has no shell ---
# WAM_AI_IDENTITY_MODE=production
# WAM_AI_DATABASE_URL=postgresql://wam_ai_business_readonly:[REDACTED]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# WAM_AI_INSTANCE_ID=gw-partner
# WAM_AI_INSTANCE_ACTOR_ID=partner-1
# WAM_AI_INSTANCE_ACTOR_ROLE=business_partner

WAM_AI_KILL_SWITCH=0
WAM_AI_QUERY_TIMEOUT_MS=15000
WAM_AI_MAX_RESPONSE_CHARS=120000
WAM_AI_RATE_LIMIT_PER_MINUTE=30

# --- Phase 1A.6 SMS (Onfon via MCP adapter — keep disabled until staged enablement) ---
# WAM_AI_SMS_ACTIONS_ENABLED=0
# WAM_AI_SMS_BROADCAST_ACTIONS_ENABLED=0
# WAM_AI_SMS_DRY_RUN=1
# WAM_AI_SMS_API_KEY=[REDACTED]
# WAM_AI_SMS_CLIENT_ID=[REDACTED]
# WAM_AI_SMS_ACCESS_KEY=[REDACTED]
# WAM_AI_SMS_SENDER_ID=[REDACTED]
# WAM_AI_SMS_RATE_LIMIT_PER_ACTOR_PER_MINUTE=6
# WAM_AI_SMS_RATE_LIMIT_PER_RECIPIENT_PER_MINUTE=3
